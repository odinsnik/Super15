&НаКлиенте
Процедура РешитьГоловоломку(Команда)
	
	ПолеИгры = Новый Массив;
	
    Для НомерСтроки = 1 По 4 Цикл
	
		Для НомерСтолбца = 1 По 4 Цикл 
			
			ТекстЯчейки = ОсновноеПоле.Область(НомерСтроки,НомерСтолбца).Текст;
			
			Попытка
				ЗначениеЯчейки = Число(ТекстЯчейки);
			Исключение
				ЗначениеЯчейки = 0;
			КонецПопытки;
			
			ПолеИгры.Добавить(ЗначениеЯчейки);
		
		КонецЦикла;
	
	КонецЦикла;
	
	НачалоРаботы = ТекущаяУниверсальнаяДатаВМиллисекундах(); 

	СтруктураПути = КратчайшийПуть(Новый ФиксированныйМассив(ПолеИгры)); 
	КратчайшийПуть = СтруктураПути.Путь.Количество();
	
	ТекущийПуть.Очистить();
	
	Для каждого Ход Из СтруктураПути.Путь Цикл
		НоваяСтрокаТекущегоПути = ТекущийПуть.Добавить();
		НоваяСтрокаТекущегоПути.Ход = Ход;
	КонецЦикла;
	
	НомерХода = 0;
	
	ВремяРаботыСекунд = Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоРаботы) / 1000); 

	Минуты = Цел(ВремяРаботыСекунд / 60);
	Секунды = ВремяРаботыСекунд % 60;

	СтрокаМинут  = Формат(Минуты, "ЧЦ=2; ЧГ=0; ЧВН=");
	СтрокаСекунд = Формат(Секунды, "ЧЦ=2; ЧГ=0; ЧВН=");

	Сообщить(СтрШаблон("Результат: %1. Время работы: %2:%3", КратчайшийПуть, СтрокаМинут, СтрокаСекунд));
	
КонецПроцедуры

&НаКлиенте
Процедура РешитьГоловоломкуJS(Команда)
	
	ПолеИгры = Новый Массив;
	
    Для НомерСтроки = 1 По 4 Цикл
	
		Для НомерСтолбца = 1 По 4 Цикл 
			
			ТекстЯчейки = ОсновноеПоле.Область(НомерСтроки,НомерСтолбца).Текст;
			
			Попытка
				ЗначениеЯчейки = Число(ТекстЯчейки);
			Исключение
				ЗначениеЯчейки = 0;
			КонецПопытки;
			
			ПолеИгры.Добавить(ЗначениеЯчейки);
		
		КонецЦикла;
	
	КонецЦикла;
    
    // Сериализация структуры в JSON-строку
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ПолеИгры);
    СтрокаJSON = ЗаписьJSON.Закрыть();
	
	УстановитьДействиеРешательJavaScriptПриНажатии();
	
    // Передаем в HTML-поле
    ОкноБраузера = Элементы.РешательJavaScript.Документ.defaultView;
    Если ОкноБраузера <> Неопределено Тогда
        // JS ответит моментально, а сам расчет уйдет в параллельный поток процессора
        Статус = ОкноБраузера.StartWorkerTask(СтрокаJSON);
		//Сообщить(Статус); 
	КонецЕсли;
	
КонецПроцедуры

