&НаСервере
Процедура СобратьПошаговоНаСервере(НомерХода)
	Ход = ТекущийПуть[НомерХода].Ход;
	НомерХода = НомерХода + 1;
	
	Если Ход = 1 Тогда
		ПереместитьСтрокуВлево(ПустоеМестоY, ПустоеМестоX+1, ПустоеМестоX+1);
	ИначеЕсли Ход = -1 Тогда
		ПереместитьСтрокуВправо(ПустоеМестоY, ПустоеМестоX-1, ПустоеМестоX-1);
	ИначеЕсли Ход = 4 Тогда
		ПереместитьКолонкуВверх(ПустоеМестоX, ПустоеМестоY+1, ПустоеМестоY+1);
	ИначеЕсли Ход = -4 Тогда
		ПереместитьКолонкуВниз(ПустоеМестоX, ПустоеМестоY-1, ПустоеМестоY-1);
	КонецЕсли;
	
КонецПроцедуры

