#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОсновноеПолеПриАктивизации(Элемент)
	
	Если Элемент.ТекущаяОбласть.Верх = Элемент.ТекущаяОбласть.Низ 
		И Элемент.ТекущаяОбласть.Лево = Элемент.ТекущаяОбласть.Право Тогда
		
		НачалоПеретаскиванияY = Элемент.ТекущаяОбласть.Верх;
		НачалоПеретаскиванияX = Элемент.ТекущаяОбласть.Лево;
		
	Иначе

		Если НачалоПеретаскиванияY = Элемент.ТекущаяОбласть.Верх 
			И НачалоПеретаскиванияY = Элемент.ТекущаяОбласть.Низ Тогда
			
			Если НачалоПеретаскиванияX < Элемент.ТекущаяОбласть.Право 
				И НачалоПеретаскиванияY = ПустоеМестоY И ПустоеМестоX > НачалоПеретаскиванияX Тогда
				
				ПереместитьСтрокуВправо(НачалоПеретаскиванияY, НачалоПеретаскиванияX, ПустоеМестоX - 1);
				
			ИначеЕсли НачалоПеретаскиванияX > Элемент.ТекущаяОбласть.Лево И НачалоПеретаскиванияX <= 4 
				И НачалоПеретаскиванияY = ПустоеМестоY И ПустоеМестоX < НачалоПеретаскиванияX Тогда

				ПереместитьСтрокуВлево(НачалоПеретаскиванияY, ПустоеМестоX + 1, НачалоПеретаскиванияX);
				
			КонецЕсли;
			
		Иначе
			
			Если НачалоПеретаскиванияY < Элемент.ТекущаяОбласть.Низ
				И НачалоПеретаскиванияX = ПустоеМестоX И ПустоеМестоY > НачалоПеретаскиванияY Тогда
				
				ПереместитьКолонкуВниз(НачалоПеретаскиванияX, НачалоПеретаскиванияY, ПустоеМестоY - 1);
				
			ИначеЕсли НачалоПеретаскиванияY > Элемент.ТекущаяОбласть.Верх И НачалоПеретаскиванияY <= 4
				И НачалоПеретаскиванияX = ПустоеМестоX И ПустоеМестоY < НачалоПеретаскиванияY Тогда

				ПереместитьКолонкуВверх(НачалоПеретаскиванияX, ПустоеМестоY + 1, НачалоПеретаскиванияY);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НачалоПеретаскиванияY = Элемент.ТекущаяОбласть.Верх Тогда
			НоваяТекСтрока = Элемент.ТекущаяОбласть.Низ;
		Иначе
			НоваяТекСтрока = Элемент.ТекущаяОбласть.Верх;
		КонецЕсли;
		
		Если НачалоПеретаскиванияX = Элемент.ТекущаяОбласть.Лево Тогда
			НоваяТекКолонка = Элемент.ТекущаяОбласть.Право;
		Иначе
			НоваяТекКолонка = Элемент.ТекущаяОбласть.Лево;
		КонецЕсли;
		
		Элемент.ТекущаяОбласть = ОсновноеПоле.Область(НоваяТекСтрока, НоваяТекКолонка);	
		
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПроверитьРазмещение", 0.5, Истина);

КонецПроцедуры

