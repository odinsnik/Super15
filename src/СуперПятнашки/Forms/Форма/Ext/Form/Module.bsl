		ТекущийПользователь = "не авторизован";

	КонецЕсли;

	ЗагрузитьНастройки();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("Макет");
	ОбластьПоля = Макет.ПолучитьОбласть();

	ОсновноеПоле.Вывести(ОбластьПоля);

	ПустоеМестоX = 4; ПустоеМестоY = 4;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("РешательJavaScript");
