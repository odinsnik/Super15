&НаКлиенте
Процедура РешательJavaScriptПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

    Если ДанныеСобытия.Event = Неопределено Тогда
        Возврат;
    КонецЕсли;

	Если ТипЗнч(ДанныеСобытия.Event.detail) <> Тип("Строка") Тогда
        Возврат; 
	КонецЕсли;
	
	СтрокаДанных = ДанныеСобытия.Event.detail;
	
	ПервыйСимвол = Лев(СокрЛП(СтрокаДанных), 1);
    Если ПервыйСимвол <> "{" И ПервыйСимвол <> "[" Тогда
        Возврат;
    КонецЕсли;	
	
	СтандартнаяОбработка = Ложь; 

	Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(СтрокаДанных);
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
		
		Если Результат.type = "progress" Тогда
			СтатусОбработкиJavaJavaScript = "Выполняется";
			ПрогрессОбработкиJavaJavaScript = СтрШаблон("Итерация (порог): %1 | Узлов: %2 | Время: %3",
			Результат.threshold,
			Результат.nodes,
			Результат.elapsed);
		ИначеЕсли Результат.type = "done" Тогда
			СтатусОбработкиJavaJavaScript = "Завершено";
			ОчиститьДействиеРешательJavaScriptПриНажатии();
			
			ТекущийПуть.Очистить();
			
			Для каждого Ход Из Результат.path Цикл
				НоваяСтрокаТекущегоПути = ТекущийПуть.Добавить();
				НоваяСтрокаТекущегоПути.Ход = Ход;
			КонецЦикла; 
			
			НомерХода = 0;
			
		ИначеЕсли Результат.type = "error" Тогда
			СтатусОбработкиJavaJavaScript = "Ошибка";
			ОчиститьДействиеРешательJavaScriptПриНажатии();
			ВызватьИсключение Результат.message;
		ИначеЕсли Результат.type = "cancel" Тогда
			СтатусОбработкиJavaJavaScript = "Прервано";
			ОчиститьДействиеРешательJavaScriptПриНажатии();
			ВызватьИсключение Результат.message;
		КонецЕсли;
        
    Исключение
        // Если JSON всё-таки оказался "битым" или поврежденным
        Предупреждение("Не удалось прочитать данные из HTML-поля! Ошибка: " + ОписаниеОшибки());
        Если ЧтениеJSON <> Неопределено Тогда
            ЧтениеJSON.Закрыть();
        КонецЕсли;
    КонецПопытки;	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииЛогикиИгры

#Область ПоискРешения

//Эвристика: Манхэттенское расстояние + Линейный конфликт.
//Показывает минимально возможное число ходов до победы.
&НаКлиентеНаСервереБезКонтекста
Функция ОценкаСостояния(ПолеИгры)

    МанхэттенскоеРасстояние = 0;
    
    Для НомерСтроки = 0 По 3 Цикл
        Для НомерСтолбца = 0 По 3 Цикл
            ЗначЯчейки = ПолеИгры[НомерСтроки * 4 + НомерСтолбца];
            Если ЗначЯчейки = 0 Тогда
                Продолжить;
            КонецЕсли;

			МанхэттенскоеРасстояние = МанхэттенскоеРасстояние 
                + АБС((ЗначЯчейки - 1) % 4 - НомерСтолбца) 
                + АБС(Цел((ЗначЯчейки - 1) / 4) - НомерСтроки);
        КонецЦикла;
    КонецЦикла;
    
    ЛинейныйКонфликт = 0;
    
    // Проверка конфликтов в строках
    Для НомерСтроки = 0 По 3 Цикл
        Для НомерСтолбца = 0 По 3 Цикл
            ЗначЯчейки = ПолеИгры[НомерСтроки * 4 + НомерСтолбца];
            
            Если ЗначЯчейки = 0 ИЛИ Цел((ЗначЯчейки - 1) / 4) <> НомерСтроки Тогда
                Продолжить;
            КонецЕсли;
            
            Для НомерСтолбца2 = НомерСтолбца + 1 По 3 Цикл
                ЗначЯчейки2 = ПолеИгры[НомерСтроки * 4 + НомерСтолбца2];
                
                Если ЗначЯчейки2 = 0 ИЛИ Цел((ЗначЯчейки2 - 1) / 4) <> НомерСтроки Тогда
                    Продолжить;
                КонецЕсли;

                Если ЗначЯчейки > ЗначЯчейки2 Тогда
                    ЛинейныйКонфликт = ЛинейныйКонфликт + 2;
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    
    // Проверка конфликтов в столбцах
    Для НомерСтолбца = 0 По 3 Цикл
        Для НомерСтроки = 0 По 3 Цикл
            ЗначЯчейки = ПолеИгры[НомерСтроки * 4 + НомерСтолбца];
            
            Если ЗначЯчейки = 0 ИЛИ (ЗначЯчейки - 1) % 4 <> НомерСтолбца Тогда
                Продолжить;
            КонецЕсли;
            
            Для НомерСтроки2 = НомерСтроки + 1 По 3 Цикл
                ЗначЯчейки2 = ПолеИгры[НомерСтроки2 * 4 + НомерСтолбца];
                
                Если ЗначЯчейки2 = 0 ИЛИ (ЗначЯчейки2 - 1) % 4 <> НомерСтолбца Тогда
                    Продолжить;
                КонецЕсли;
                
                Если ЗначЯчейки > ЗначЯчейки2 Тогда
                    ЛинейныйКонфликт = ЛинейныйКонфликт + 2;
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    
    Возврат МанхэттенскоеРасстояние + ЛинейныйКонфликт;
    
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция АБС(Значение)
		
	Возврат ?(Значение >= 0, Значение, -Значение);

КонецФункции

//Проверяет, можно ли в принципе собрать данную комбинацию.
&НаКлиентеНаСервереБезКонтекста
Функция РешениеСуществует(Поле)

    Инверсии = 0;
    Плоский = Новый Массив(Поле);
    
    НулевойИндекс = Поле.Найти(0);
	
	Плоский.Удалить(НулевойИндекс);
    
    Для i = 0 По Плоский.Количество() - 1 Цикл
        Для j = i + 1 По Плоский.Количество() - 1 Цикл
            Если Плоский[i] > Плоский[j] Тогда
                Инверсии = Инверсии + 1;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    
    СтрокаСнизу = 4 - Цел(НулевойИндекс / 4);
    
    Если СтрокаСнизу % 2 = 1 Тогда
        Возврат Инверсии % 2 = 0;
    Иначе
        Возврат Инверсии % 2 = 1;
	КонецЕсли;
	
КонецФункции

// Возвращает список возможных состояний после хода
&НаКлиентеНаСервереБезКонтекста
Функция ВозможныеХоды(Поле)
	
	Ходы = Новый Массив;
	Поля = Новый Массив;
	
	СтруктураВозможныхХодов = Новый Структура;
	СтруктураВозможныхХодов.Вставить("Ходы", Ходы);
	СтруктураВозможныхХодов.Вставить("Поля", Поля);
	
    ПустойИндекс = Поле.Найти(0);
    r = Цел(ПустойИндекс / 4);
    c = ПустойИндекс % 4;
    
    Направления = Новый Массив;
    Если r > 0 Тогда Направления.Добавить(-4); КонецЕсли; // Вверх
    Если r < 3 Тогда Направления.Добавить(4);  КонецЕсли; // Вниз
    Если c > 0 Тогда Направления.Добавить(-1); КонецЕсли; // Влево
    Если c < 3 Тогда Направления.Добавить(1);  КонецЕсли; // Вправо
    
    Для Каждого Дельта Из Направления Цикл
        НовыйИндекс = ПустойИндекс + Дельта;
        НовоеПоле = Новый Массив(Поле);
        // Меняем местами 0 и фишку
        Врем = НовоеПоле[ПустойИндекс];
        НовоеПоле[ПустойИндекс] = НовоеПоле[НовыйИндекс];
        НовоеПоле[НовыйИндекс] = Врем;
        Поля.Добавить(Новый ФиксированныйМассив(НовоеПоле));
		Ходы.Добавить(Дельта);
    КонецЦикла;
    
    Возврат СтруктураВозможныхХодов;
КонецФункции

//Запуск алгоритма IDA* для поиска кратчайшего пути.
&НаКлиентеНаСервереБезКонтекста
Функция КратчайшийПуть(НачальноеПоле)
	
	Если Не РешениеСуществует(НачальноеПоле) Тогда
        Возврат Неопределено; // Нерешаемо
    КонецЕсли;
    
    Порог = ОценкаСостояния(НачальноеПоле);
	
	СтруктураПути = Новый Структура("ПоляВПути, Путь, ХэшТаблица");
	
	СтруктураПути.Путь = Новый Массив;
	СтруктураПути.ПоляВПути = Новый Массив;
    СтруктураПути.ПоляВПути.Добавить(НачальноеПоле);
	СтруктураПути.ХэшТаблица = Новый Соответствие;
	СтруктураПути.ХэшТаблица.Вставить(СтрСоединить(НачальноеПоле, "-"), 1);
    
    Пока Истина Цикл
        Результат = Поиск(СтруктураПути, 0, Порог);
        Если Результат = 0 Тогда
            Возврат СтруктураПути; // Возвращаем всю структуру пути.
        ИначеЕсли Результат = 1000000 Тогда
            Возврат Неопределено; // Не найдено
        Иначе
            Порог = Результат;
        КонецЕсли;
    КонецЦикла;
КонецФункции

// Рекурсивный поиск вглубь с ограничением (IDA*)
&НаКлиентеНаСервереБезКонтекста
Функция Поиск(СтруктураПути, g, Порог)
	
	Путь = СтруктураПути.Путь;
	ПоляВПути = СтруктураПути.ПоляВПути;
	ХэшТаблица = СтруктураПути.ХэшТаблица;
	
	ТекущееПоле = СтруктураПути.ПоляВПути[ПоляВПути.ВГраница()];
	
	ЭвристическаяОценка = ОценкаСостояния(ТекущееПоле);
    
	Если ЭвристическаяОценка = 0 Тогда
	    Возврат 0;
	КонецЕсли;
	
	f = g + ЭвристическаяОценка;
    
    Если f > Порог Тогда
        Возврат f;
    КонецЕсли;
    
    Минимум = 1000000;
	
	СтруктураВозможныхХодов = ВозможныеХоды(ТекущееПоле);
	
	Для ИндексВозможногоХода = 0 По СтруктураВозможныхХодов.Ходы.ВГраница() Цикл
	
   		СледующееПоле = СтруктураВозможныхХодов.Поля[ИндексВозможногоХода];
   		СледующийХод = СтруктураВозможныхХодов.Ходы[ИндексВозможногоХода];
		
        // Проверка на отсутствие в пути (защита от циклов)
		ХэшТекущегоПоля = СтрСоединить(СледующееПоле, "-");
        УжеВПути = ХэшТаблица[ХэшТекущегоПоля] <> Неопределено;
        
        Если Не УжеВПути Тогда
			
			ПоляВПути.Добавить(СледующееПоле);
			ХэшТаблица.Вставить(ХэшТекущегоПоля, 1);
			Путь.Добавить(СледующийХод);
			
            Временное = Поиск(СтруктураПути, g + 1, Порог);
            Если Временное = 0 Тогда
                Возврат 0;
            КонецЕсли;
            Если Временное < Минимум Тогда
                Минимум = Временное;
			КонецЕсли;
			
            ПоляВПути.Удалить(ПоляВПути.ВГраница()); // Откат
			ХэшТаблица.Удалить(ХэшТекущегоПоля);
			Путь.Удалить(Путь.ВГраница());
        КонецЕсли;
    КонецЦикла;
    
    Возврат Минимум;
КонецФункции

// Генерация случайного решаемого поля
&НаКлиентеНаСервереБезКонтекста
Функция СгенерироватьСлучайноеПоле(Генератор)

	Пока Истина Цикл
        Поле = Новый Массив;
        Для i = 0 По 15 Цикл
            Поле.Добавить(i);
        КонецЦикла;
        // Перемешивание Фишера-Йетса
		i = 15;
        Пока i >= 1 Цикл
            j = Генератор.СлучайноеЧисло(0, i);
            Врем = Поле[i];
            Поле[i] = Поле[j];
            Поле[j] = Врем;
			i = i - 1;
		КонецЦикла; 
		
		Результат = Новый ФиксированныйМассив(Поле);
		
        Если РешениеСуществует(Результат) Тогда
            Возврат Результат;
        КонецЕсли;
	КонецЦикла;
	
КонецФункции

// Вспомогательная функция: сравнение двух полей
&НаКлиентеНаСервереБезКонтекста
Функция СравнитьПоля(Поле1, Поле2)
	Возврат СтрСоединить(Поле1,"-") = СтрСоединить(Поле2,"-");
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ПроверитьРазмещение()
	
	Если ОсновноеПоле.Область(1,1).Текст = "1"
		И ОсновноеПоле.Область(1,2).Текст = "2"
		И ОсновноеПоле.Область(1,3).Текст = "3"
		И ОсновноеПоле.Область(1,4).Текст = "4"
		
		И ОсновноеПоле.Область(2,1).Текст = "5"
		И ОсновноеПоле.Область(2,2).Текст = "6"
		И ОсновноеПоле.Область(2,3).Текст = "7"
		И ОсновноеПоле.Область(2,4).Текст = "8"

		И ОсновноеПоле.Область(3,1).Текст = "9"
		И ОсновноеПоле.Область(3,2).Текст = "10"
		И ОсновноеПоле.Область(3,3).Текст = "11"
		И ОсновноеПоле.Область(3,4).Текст = "12"

		И ОсновноеПоле.Область(4,1).Текст = "13"
		И ОсновноеПоле.Область(4,2).Текст = "14"
		И ОсновноеПоле.Область(4,3).Текст = "15" Тогда                            
		
		ВставитьСимволПобеды();

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВставитьСимволПобеды()

	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");

	ОсновноеПоле.ВставитьОбласть(Макет.Область(4, 4), ОсновноеПоле.Область(4, 4), 
				ТипСмещенияТабличногоДокумента.БезСмещения,
				Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Перемешать()

	Если СлучайноеЗерно Тогда
		
		Гена = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
		
		ЗерноГСЧ = Гена.СлучайноеЧисло(0, 10000);
		
	КонецЕсли;
	
	Гена = Новый ГенераторСлучайныхЧисел(ЗерноГСЧ);
	
	СлучайноеПоле = СгенерироватьСлучайноеПоле(Гена);
	
	ОтобразитьПоле(СлучайноеПоле);

КонецПроцедуры

&НаСервере
Процедура ОтобразитьПоле(Поле)
	
	ОсновноеПоле.Очистить();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("Макет");
	ОбластьПоля = Макет.ПолучитьОбласть();
	
	ОсновноеПоле.Вывести(ОбластьПоля);
	
	НомерСтрокиЯчейки = 1;
	НомерКолонкиЯчейки = 1;
	
	Для каждого ЗначЯчейки Из Поле Цикл
		
		Если ЗначЯчейки = 0 Тогда
			
			ОсновноеПоле.УдалитьОбласть(ОсновноеПоле.Область(НомерСтрокиЯчейки, НомерКолонкиЯчейки), 
				ТипСмещенияТабличногоДокумента.БезСмещения);
	
			ПустоеМестоX = НомерКолонкиЯчейки; ПустоеМестоY = НомерСтрокиЯчейки;
		
		Иначе	
		
			НомерСтрокиВМакете = (ЗначЯчейки - 1) % 4 + 1; 
			НомерКолонкиВМакете = Цел((ЗначЯчейки - 1) / 4) + 1;
			
			ОбластьИзМакета = ОбластьПоля.Область(НомерСтрокиВМакете, НомерКолонкиВМакете);
			
			ОсновноеПоле.ВставитьОбласть(ОбластьИзМакета,
				ОсновноеПоле.Область(НомерСтрокиЯчейки, НомерКолонкиЯчейки), 
				ТипСмещенияТабличногоДокумента.БезСмещения,
				Ложь);
				
		КонецЕсли;
		
		НомерКолонкиЯчейки = НомерКолонкиЯчейки + 1;
		Если НомерКолонкиЯчейки = 5 Тогда
			
			НомерСтрокиЯчейки = НомерСтрокиЯчейки + 1;
			НомерКолонкиЯчейки = 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьСтрокуВлево(НомерСтроки, НачКол, КонКол)
	
	Если НомерСтроки < 1 Или НомерСтроки > 4 Тогда
		Возврат;
	КонецЕсли;

	ПустоеМестоX = КонКол;
	
	ОсновноеПоле.ВставитьОбласть(ОсновноеПоле.Область(НомерСтроки, НачКол, НомерСтроки, КонКол),
		ОсновноеПоле.Область(НомерСтроки, НачКол - 1, НомерСтроки, КонКол - 1), 
			ТипСмещенияТабличногоДокумента.БезСмещения,
			Ложь);

	ОсновноеПоле.УдалитьОбласть(ОсновноеПоле.Область(НомерСтроки, КонКол),
			ТипСмещенияТабличногоДокумента.БезСмещения);

КонецПроцедуры

&НаСервере
Процедура ПереместитьКолонкуВверх(НомерКолонки, НачСтр, КонСтр)
	
	Если НомерКолонки < 1 Или НомерКолонки > 4 Тогда
		Возврат;
	КонецЕсли;

	ПустоеМестоY = КонСтр;

	ОсновноеПоле.ВставитьОбласть(ОсновноеПоле.Область(НачСтр, НомерКолонки, КонСтр, НомерКолонки),
		ОсновноеПоле.Область(НачСтр - 1, НомерКолонки, КонСтр - 1, НомерКолонки), 
			ТипСмещенияТабличногоДокумента.БезСмещения,
			Ложь);

	ОсновноеПоле.УдалитьОбласть(ОсновноеПоле.Область(КонСтр, НомерКолонки),
			ТипСмещенияТабличногоДокумента.БезСмещения);

КонецПроцедуры

&НаСервере
Процедура ПереместитьСтрокуВправо(НомерСтроки, НачКол, КонКол)
	
	Если НомерСтроки < 1 Или НомерСтроки > 4 Тогда
		Возврат;
	КонецЕсли;
	
	ПустоеМестоX = НачКол;

	ОсновноеПоле.ВставитьОбласть(ОсновноеПоле.Область(НомерСтроки, НачКол, НомерСтроки, КонКол),
		ОсновноеПоле.Область(НомерСтроки, НачКол + 1, НомерСтроки, КонКол + 1), 
			ТипСмещенияТабличногоДокумента.БезСмещения,
			Ложь);

	ОсновноеПоле.УдалитьОбласть(ОсновноеПоле.Область(НомерСтроки, НачКол),
			ТипСмещенияТабличногоДокумента.БезСмещения);

КонецПроцедуры

&НаСервере
Процедура ПереместитьКолонкуВниз(НомерКолонки, НачСтр, КонСтр)
	
	Если НомерКолонки < 1 Или НомерКолонки > 4 Тогда
		Возврат;
	КонецЕсли;

	ПустоеМестоY = НачСтр;
	
	ОсновноеПоле.ВставитьОбласть(ОсновноеПоле.Область(НачСтр, НомерКолонки, КонСтр, НомерКолонки),
		ОсновноеПоле.Область(НачСтр + 1, НомерКолонки, КонСтр + 1, НомерКолонки), 
			ТипСмещенияТабличногоДокумента.БезСмещения,
			Ложь);

	ОсновноеПоле.УдалитьОбласть(ОсновноеПоле.Область(НачСтр, НомерКолонки),
			ТипСмещенияТабличногоДокумента.БезСмещения);

КонецПроцедуры

#КонецОбласти

#Область СохранениеЗагрузкаНастроек

&НаКлиентеНаСервереБезКонтекста
Функция ИдентификаторНастроек()
	Возврат "1С&Антистресс.СуперПятнашки";
КонецФункции

&НаСервере
Процедура ЗагрузитьНастройки()
	
	ХранилищеНастроекОбработки = ХранилищеСистемныхНастроек.ЗагрузитьНастройкуПоУмолчанию(ИдентификаторНастроек());	
	
	Если ТипЗнч(ХранилищеНастроекОбработки) = Тип("ХранилищеЗначения") Тогда
		
		СтруктураНастроек = ХранилищеНастроекОбработки.Получить();
		
		Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
			
			НастройкиГСЧ = Неопределено;
			
			СтруктураНастроек.Свойство("НастройкиГСЧ", НастройкиГСЧ);

			Если ТипЗнч(НастройкиГСЧ) = Тип("Структура") Тогда
				
				ЗерноГСЧ = НастройкиГСЧ.ЗерноГСЧ;
				СлучайноеЗерно = НастройкиГСЧ.СлучайноеЗерно;
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
	
	СтруктураНастроек = Новый Структура;
	
	НастройкиГСЧ = Новый Структура;
	
	НастройкиГСЧ.Вставить("ЗерноГСЧ", ЗерноГСЧ);
	НастройкиГСЧ.Вставить("СлучайноеЗерно", СлучайноеЗерно);
	
	СтруктураНастроек.Вставить("НастройкиГСЧ", НастройкиГСЧ);

	ХранилищеНастроекОбработки = Новый ХранилищеЗначения(СтруктураНастроек, Новый СжатиеДанных(7));
	
	ХранилищеСистемныхНастроек.СохранитьНастройкуПоУмолчанию(ИдентификаторНастроек(), ХранилищеНастроекОбработки);
	
КонецПроцедуры 

#КонецОбласти
